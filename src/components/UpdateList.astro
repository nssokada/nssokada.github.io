---
import type { Update } from '../data/updates';
import { renderInline, formatUpdateDate } from '../lib/inline';

interface Props {
  items: Update[];
}
const { items } = Astro.props;
---

<ul class="updates">
  {
    items.map((u) => (
      <li>
        <time datetime={u.date}>[{formatUpdateDate(u.date)}]</time>
        <span set:html={renderInline(u.text)} />
      </li>
    ))
  }
</ul>

<style>
  .updates { list-style: none; margin: 0; padding: 0; max-width: 760px; }
  li { display: grid; grid-template-columns: 5em minmax(0, 1fr); gap: 0 14px; padding-block: 4px; align-items: baseline; }
  time { color: var(--muted); font-size: 15px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 520px) {
    li { grid-template-columns: minmax(0, 1fr); padding-block: 9px; }
    time { font-size: 15px; }
  }
</style>
