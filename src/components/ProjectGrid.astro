---
import ProjectCard from './ProjectCard.astro';
import { summaryFor, type Project } from '../lib/projects';
import type { AudienceKey } from '../data/audiences';

interface Props {
  projects: Project[];
  audience: AudienceKey;
  headingLevel?: 'h2' | 'h3';
}
const { projects, audience, headingLevel = 'h3' } = Astro.props;
---

<ul class="grid" data-count={projects.length}>
  {
    projects.map((project) => (
      <li>
        <ProjectCard project={project} summary={summaryFor(project, audience)} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(30px, 4vw, 44px) clamp(22px, 3.5vw, 36px);
  }
  .grid[data-count='1'] { grid-template-columns: minmax(0, 1fr); max-width: 442px; }
  @media (max-width: 720px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
