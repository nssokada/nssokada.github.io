---
import { url } from '../lib/url';
const current = Astro.url.pathname;
const tabs = [
  { label: 'all research', path: '/research/' },
  { label: 'neuroscience', path: '/research/neuroscience/' },
  { label: 'cognition', path: '/research/cognition/' },
  { label: 'ai', path: '/research/ai/' },
];
---

<nav class="tabs" aria-label="Research views">
  {
    tabs.map((t) => (
      <a href={url(t.path)} aria-current={current === url(t.path) ? 'page' : undefined}>
        <span aria-hidden="true">/</span>{t.label}
      </a>
    ))
  }
</nav>
