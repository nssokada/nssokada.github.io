---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Label from '../../components/Label.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---

<Base title="Writing" description="Essays and notes by Noah Okada on emotion, cognition, AI alignment, neurotechnology, and markets.">
  <section class="wrap page-head">
    <h1>Writing</h1>
    <p class="lede">
      Essays and notes on emotion and neuroscience, cognition, AI alignment, neurotechnology, and markets.
    </p>
  </section>

  <section class="wrap section">
    {
      posts.length > 0 ? (
        <>
          <Label>essays and notes</Label>
          <ul class="rows">
            {posts.map((post) => (
              <li>
                <div>
                  <h2 style="font-size: 17px"><a href={url(`/writing/${post.id}/`)}>{post.data.title}</a></h2>
                  <p>{post.data.summary}</p>
                </div>
                <span class="meta">{fmt.format(post.data.date)}</span>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="read">
          Nothing published here yet. In the meantime, the longer write-ups on this site are the{' '}
          <a href={url('/research/')}>research project pages</a>.
        </p>
      )
    }
  </section>
</Base>
