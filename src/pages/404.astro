---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <!-- The site first lived under /portfolio/. Forward any old link to its new address. -->
  <script is:inline>
    (function () {
      var m = location.pathname.match(/^\/portfolio(\/.*)?$/);
      if (m) location.replace((m[1] || '/') + location.search + location.hash);
    })();
  </script>
  <section class="wrap page-head">
    <h1>/404</h1>
    <p class="lede">
      That page doesn't exist. Try the <a href={url('/')}>homepage</a> or the{' '}
      <a href={url('/research/')}>research collection</a>.
    </p>
  </section>
</Base>
