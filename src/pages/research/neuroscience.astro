---
import Base from '../../layouts/Base.astro';
import Label from '../../components/Label.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import PublicationList from '../../components/PublicationList.astro';
import ResearchTabs from '../../components/ResearchTabs.astro';
import { projectsFor } from '../../lib/projects';
import { publications } from '../../data/publications';

const projects = await projectsFor('neuroscience');
const pubs = publications.filter((p) => p.key !== 'llm-compromise-2026');
---

<Base
  title="Neuroscience research"
  description="Noah Okada's neuroscience research at Caltech and Emory: anxiety and decision-making, déjà vu and memory in virtual reality, and remote memory assessment."
>
  <section class="wrap page-head">
    <h1>How emotion shapes cognition and decision-making.</h1>
    <p class="lede">
      I'm a PhD researcher in Social and Decision Neuroscience at Caltech, advised by Dean Mobbs. My work combines
      online behavioral studies, computational modeling, and immersive virtual reality.
    </p>
    <ResearchTabs />
  </section>

  <section class="wrap section">
    <Label>projects</Label>
    <ProjectGrid projects={projects} audience="neuroscience" />
  </section>

  <section class="wrap section">
    <Label>other work</Label>
    <p class="read">
      At Caltech I've also developed immersive VR experiments with eye tracking and physiological monitoring to study
      arousal and effort. In 2022, at Stanford with Josef Parvizi, I developed an immersive VR spatial memory task for
      clinical research with intracranial EEG patients.
    </p>
  </section>

  <section class="wrap section">
    <Label>publications</Label>
    <PublicationList items={pubs} />
  </section>
</Base>
